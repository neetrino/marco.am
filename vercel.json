{
  "buildCommand": "pnpm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "installCommand": "pnpm install && pnpm run db:generate",
  "devCommand": "pnpm run dev",
  "functions": {
    "src/app/api/v1/supersudo/products/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/v1/supersudo/products/upload-images/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/v1/cron/reconcile-payments/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/v1/cron/cleanup-guest-lists/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/v1/cron/reconcile-payments",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/v1/cron/cleanup-guest-lists",
      "schedule": "0 4 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    }
  ]
}
